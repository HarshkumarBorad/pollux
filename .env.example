# --- LLM ---
# HuggingFace Inference Providers — same one DocuMind uses.
# Get a free token at https://huggingface.co/settings/tokens.
HF_TOKEN=
HF_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_INFERENCE_PROVIDER=auto

# Optional OpenAI fallback used ONLY by the Coordinator and Ops Planner agents,
# where stronger reasoning produces noticeably better routing / planning.
# Leave blank to use HF for everything (the default).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage ---
# Default SQLite in the working directory. Swap to a real database for prod:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/pollux
DATABASE_URL=sqlite+aiosqlite:///pollux.db

# --- Telemetry ---
LOG_LEVEL=INFO
LOG_FORMAT=text                 # text (dev) | json (prod)
OTEL_SERVICE_NAME=pollux
# Leave blank for stdout-only tracing in dev. Set to your collector URL for prod:
#   OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_ENDPOINT=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- App ---
APP_ENV=dev                     # dev | staging | production

# --- Orchestration variant (Phases 6 + 7) ---
# Picks how agents talk to each other. Same business logic either way.
#   mcp — Anthropic Model Context Protocol (FastMCP server)
#   a2a — Google Agent-to-Agent (per-agent HTTP endpoints + Agent Cards)
POLLUX_ORCHESTRATION=mcp
